# ── Server-only (never prefix these with VITE_) ──────────────────────────────
# Groq API key from https://console.groq.com/keys (starts with gsk_)
# Local: put it in .env (this file is git-ignored).
# Netlify: Site configuration → Environment variables → GROQ_API_KEY
GROQ_API_KEY=

# Optional: extra site origins allowed to call /api/ai (comma-separated)
ALLOWED_ORIGINS=
# Optional: flood guard — AI requests per minute from one network address (default 600)
RATE_LIMIT_PER_MINUTE=

# ── Public (bundled into the website — safe to expose) ──────────────────────
# Google sign-in OAuth Web client ID (EUREKA's is built in; set only to override)
VITE_GOOGLE_CLIENT_ID=931768065843-721uksotvjdh09s07bs51fo8rl0hmrfa.apps.googleusercontent.com

# Optional: override the Whop checkout links built into src/lib/plans.js
VITE_CHECKOUT_PRO_MONTHLY=
VITE_CHECKOUT_PRO_YEARLY=
VITE_CHECKOUT_MAX_MONTHLY=
VITE_CHECKOUT_MAX_YEARLY=

# Only if the API is hosted on a different domain than the website
VITE_API_BASE=

# Paid plans (server only). Whop company API key with member:basic:read, used to check
# customers' license keys. PLAN_SECRET signs plan passes (any long random text).
WHOP_API_KEY=
PLAN_SECRET=
# Optional: your own Max unlock. Type it into Account → "Activate a purchase" on the live site.
# 24+ letters/numbers (e.g. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))").
OWNER_KEY=
# Optional: lets you run /api/ai/health?test=1&admin=<ADMIN_TOKEN> on the live site.
ADMIN_TOKEN=

# Optional: your Groq tokens-per-minute limit (free tier = 8000). EUREKA also learns it
# from Groq's errors. Raise it after upgrading Groq so longer replies are reserved.
GROQ_TPM_LIMIT=

# ── Scaling to thousands of students (all server only, all optional) ────────
# Extra AI providers. When Groq is full, EUREKA overflows to these automatically, and if
# one provider is down or its key is wrong, the others keep answering.
# OpenRouter (https://openrouter.ai/keys, add credits) — strongly recommended for scale.
OPENROUTER_API_KEY=
# Cerebras (https://cloud.cerebras.ai) — fast GPT-OSS 120B.
CEREBRAS_API_KEY=
# Any other OpenAI-compatible host (up to 3): base URL, key, and the EUREKA model ids it serves.
# AI_PROVIDER_1_NAME=Together
# AI_PROVIDER_1_BASE=https://api.together.xyz/v1
# AI_PROVIDER_1_KEY=
# AI_PROVIDER_1_MODELS=openai/gpt-oss-120b=openai/gpt-oss-120b,openai/gpt-oss-20b=openai/gpt-oss-20b

# Shared fair-use counters (daily allowance per student, per-minute burst). Without these the
# counts live in each server instance's memory, which is fine for one server but not for
# Vercel/Cloudflare at scale. Vercel → Storage/Marketplace → Upstash Redis adds them for you
# (as KV_REST_API_URL / KV_REST_API_TOKEN, which also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Free students sharing one network (a school's Wi-Fi). Paying members are exempt.
NETWORK_DAILY_LIMIT=6000
NETWORK_MINUTE_LIMIT=600
